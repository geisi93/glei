<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:popup="using:TriasDeparture.Linux.Popup"
        mc:Ignorable="d"
        x:Class="TriasDeparture.Linux.Popup.PopupWindow"
        x:DataType="popup:PopupViewModel"
        x:Name="Root"
        Title="glei"
        Icon="avares://glei/Assets/glei.ico"
        Width="360" Height="480"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <!-- Line number as accent-colored badge -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Flat list entry -->
        <Style Selector="Button.list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.icon.favorite">
            <Setter Property="Foreground" Value="#FBBF24" />
        </Style>
        <!-- Cancelled trip: struck through and faded -->
        <Style Selector="Grid.cancelled TextBlock.destination">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.cancelled TextBlock.minutes">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="StopTemplate" x:DataType="popup:StopItem">
            <Button Classes="list"
                    Command="{Binding #Root.((popup:PopupViewModel)DataContext).OpenStopCommand}" CommandParameter="{Binding}">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid Margin="16" RowDefinitions="Auto,Auto,*">

            <!-- ── Favorite ───────────────────────────────────────────── -->
            <StackPanel Grid.Row="0">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="★" Foreground="#FBBF24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding FavoriteTitle}" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding FavoriteTitle}" />
                </Grid>

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding FavoriteRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="popup:DepartureRow">
                            <Grid Margin="0,3" ColumnDefinitions="Auto,*,Auto,14" Classes.cancelled="{Binding IsCancelled}">
                                <Border Classes="badge">
                                    <TextBlock Text="{Binding Line}" />
                                </Border>
                                <TextBlock Classes="destination" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                           Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="minutes" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding Minutes}" />
                                <Ellipse Grid.Column="3" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="#FBBF24" ToolTip.Tip="Echtzeit" IsVisible="{Binding IsRealtime}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding FavoriteStatus}"
                           Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,12" />

            <!-- ── Search ─────────────────────────────────────────────── -->
            <DockPanel Grid.Row="2" LastChildFill="True">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                    <Button Classes="icon" Content="←" ToolTip.Tip="Zurück (Esc)"
                            Command="{Binding BackCommand}" Margin="0,0,6,0" IsVisible="{Binding ShowStop}" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Haltestelle suchen …"
                                 IsVisible="{Binding !ShowStop}" />
                        <TextBlock Text="{Binding SelectedStop.DisplayName, FallbackValue=''}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowStop}" />
                    </Grid>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Margin="2,8,0,0" Classes="secondary" TextWrapping="Wrap"
                           Text="{Binding StatusLine}" />

                <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Recent stops -->
                        <StackPanel IsVisible="{Binding ShowRecent}">
                            <TextBlock Text="Zuletzt" Classes="secondary" Margin="2,0,0,4" />
                            <ItemsControl ItemsSource="{Binding RecentStops}" ItemTemplate="{StaticResource StopTemplate}" Focusable="False" />
                        </StackPanel>

                        <!-- Search results -->
                        <ItemsControl x:Name="ResultList" ItemsSource="{Binding StopResults}" ItemTemplate="{StaticResource StopTemplate}"
                                      Focusable="False" IsVisible="{Binding ShowResults}" />

                        <!-- Departures of the chosen stop, grouped by line and direction -->
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" IsVisible="{Binding ShowStop}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="popup:GroupItem">
                                    <Grid Margin="0,4" ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Classes="badge">
                                            <TextBlock Text="{Binding Line}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                                   Text="{Binding Label, StringFormat='→ {0}'}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Minutes}" />
                                        <Button Grid.Column="3" Margin="6,0,0,0" Classes="icon" Classes.favorite="{Binding IsFavorite}"
                                                Content="{Binding IsFavorite, Converter={x:Static popup:StarConverter.Instance}}"
                                                ToolTip.Tip="{Binding IsFavorite, Converter={x:Static popup:StarConverter.ToolTip}}"
                                                Command="{Binding #Root.((popup:PopupViewModel)DataContext).MakeFavoriteCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanBeFavorite}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
